VAL_ 1537 GatewayState 2 "DEGRADED" 1 "NORMAL" 0 "INIT" ;
VAL_ 1537 OtaState 6 "FAILED" 5 "SUCCESS" 4 "READY_TO_ACTIVATE" 3 "VERIFYING" 2 "RECEIVING" 1 "START" 0 "IDLE" ;
