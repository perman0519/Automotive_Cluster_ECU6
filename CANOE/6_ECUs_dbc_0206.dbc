VAL_ 1616 OtaRequestCommand 17 "SEND_KEY" 16 "REQUEST_SEED" 5 "ABORT" 4 "ACTIVATE" 3 "END" 2 "DATA" 1 "START" ;

VAL_ 1617 OtaResponseCode 127 "NACK" 121 "ACK" ;
VAL_ 1617 OtaEchoCommand 17 "SEND_KEY" 16 "REQUEST_SEED" 5 "ABORT" 4 "ACTIVATE" 3 "END" 2 "DATA" 1 "START" ;
VAL_ 1617 OtaResponseDetail 35 "SECURITY_LOCKOUT" 34 "INVALID_KEY" 33 "SEED_REQUIRED" 32 "SECURITY_LOCKED" 24 "INVALID_AUTH" 23 "CHECKSUM_MISMATCH" 22 "BUFFER_OVERFLOW" 21 "INVALID_DATA_LENGTH" 20 "INVALID_SEQUENCE" 18 "UNKNOWN_COMMAND" 17 "INVALID_DLC" 16 "INVALID_ID" 0 "ACCEPTED_OR_SEED" ;
VAL_ 1617 OtaResponseState 6 "FAILED" 5 "SUCCESS" 4 "READY_TO_ACTIVATE" 3 "VERIFYING" 2 "RECEIVING" 1 "START" 0 "IDLE" ;

VAL_ 2015 UDSFuncServiceId 46 "WriteDataByIdentifier" 39 "SecurityAccess" 34 "ReadDataByIdentifier" 25 "ReadDTCInformation" 20 "ClearDiagnosticInformation" 17 "ECUReset" 16 "DiagnosticSessionControl" ;
VAL_ 2016 UDSPhysServiceId 46 "WriteDataByIdentifier" 39 "SecurityAccess" 34 "ReadDataByIdentifier" 25 "ReadDTCInformation" 20 "ClearDiagnosticInformation" 17 "ECUReset" 16 "DiagnosticSessionControl" ;
VAL_ 2024 UDSResponseServiceId 127 "NegativeResponse" 110 "WriteDataByIdentifierPositive" 103 "SecurityAccessPositive" 98 "ReadDataByIdentifierPositive" 89 "ReadDTCInformationPositive" 84 "ClearDiagnosticInformationPositive" 81 "ECUResetPositive" 80 "DiagnosticSessionControlPositive" ;
VAL_ 2024 UDSResponseData1OrNrc 53 "InvalidKey" 51 "SecurityAccessDenied" 49 "RequestOutOfRange" 34 "ConditionsNotCorrect" 19 "IncorrectMessageLength" 18 "SubFunctionNotSupported" 17 "ServiceNotSupported" ;
